# Copy to .env. Replace every value marked CHANGE_ME before deployment.
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=sovereign_db
# URL-encode special characters in the database password if you use any.
DATABASE_URL=postgresql://sovereign:CHANGE_ME_use_a_long_random_password@postgres:5432/sovereign_db
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_bytes_with_openssl
SOVEREIGN_DOMAIN=chat.example.com
# Comma-separated browser origins if you expose a browser client. Native Android needs no CORS entry.
CORS_ORIGINS=
